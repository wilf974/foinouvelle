# Configuration Nginx temporaire pour Foi Nouvelle (avant génération du certificat SSL)
# À placer dans /etc/nginx/sites-available/foinouvelle

# Configuration HTTP uniquement (Certbot ajoutera HTTPS automatiquement)
server {
    listen 80;
    listen [::]:80;
    server_name foinouvelle.woutils.com;
    
    # Taille maximale des uploads
    client_max_body_size 10M;
    
    # Logs
    access_log /var/log/nginx/foinouvelle-access.log;
    error_log /var/log/nginx/foinouvelle-error.log;
    
    # Proxy vers le conteneur Docker
    location / {
        proxy_pass http://127.0.0.1:2000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

